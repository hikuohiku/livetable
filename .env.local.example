# mysql
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

## prisma (relace it with your own settings)
# DATABASE_URL="mysql://<username>:<password>@<ip-address>:<port>/<database-name>"
# primsa (root user for migration)
DATABASE_URL=

# google credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# youtube api key
YOUTUBE_API_KEY=

# next-auth
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# debug
DEBUG=true
PRISMA_QUERY_LOG=true

